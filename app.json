{
  "expo": {
    "name": "Beck App",
    "slug": "beckapp",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "beckcrmapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beckcrm.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Beck App necesita acceder al servidor local de desarrollo.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.expotest2sorganization.beckapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-foreground-small.png",
        "backgroundColor": "#facc15"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/beck-splash-logo.png",
          "imageWidth": 340,
          "resizeMode": "contain",
          "backgroundColor": "#facc15",
          "dark": {
            "image": "./assets/images/beck-splash-logo.png",
            "backgroundColor": "#facc15"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5f84148-22c0-48ed-b27f-2cf06ac3704a"
      }
    },
    "owner": "beck1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f5f84148-22c0-48ed-b27f-2cf06ac3704a"
    }
  }
}
